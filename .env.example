# ============================================================================
# Server Bind Address & Port
# ============================================================================
HOST=127.0.0.1
PORT=6718

# ============================================================================
# Security & Console Access Control
# ============================================================================
# Initial master client API token(s) for /v1/* inference endpoints (comma-separated).
# Automatically imported into `gateway-keys.json` on first boot; additional sub-keys
# with per-key model allowlists, request limits, and expiration can be created in the Console.
GATEWAY_TOKEN=

# Dedicated password for unlocking the web management console (min 8 chars recommended).
# Strongly recommended for public deployments! Separates admin access from client API keys
# and enables IP brute-force lockout protection (8 failed attempts = 15 min IP lock).
ADMIN_PASSWORD=

# Reverse proxy header trust policy: `loopback` (default) | `all` | `off`.
# Set `off` if exposed directly to the internet without a reverse proxy so callers cannot spoof X-Forwarded-For.
# TRUST_PROXY=loopback

# Mount the built-in Web Console & `/v1/admin/*` management API (`true` | `false`).
# Tip: Set `ENABLE_DASHBOARD=false` if running in pure headless proxy mode!
ENABLE_DASHBOARD=true

# Let clients enable Cursor cloud web search / web fetch (web_search*, web_fetch tools).
# Defaults to `false` for security (prevents extra quota burn & URL fetch abuse); can be hot-toggled in the Web Console.
ALLOW_NATIVE_WEB_TOOLS=false

# Custom URL path for the management console (default: `/dashboard`).
# Security Tip: Set a custom random path in production (e.g. `/adm-9f4c2e`) so automated
# scanners probing `/dashboard` receive `404 Not Found`!
DASHBOARD_PATH=/dashboard

# ============================================================================
# Upstream Cursor Account Pool & Routing Policy
# ============================================================================
# Active upstream Cursor User API Key(s) (`crsr_...`), comma-separated.
# Also powers zero-cookie real-time Auto Pool % & API Pool % quota sync.
CURSOR_API_KEYS=

# Optional standby/disabled Cursor API Key(s) (`crsr_...`).
DISABLED_CURSOR_API_KEYS=

# Optional globally disabled base model IDs (comma-separated), managed via Console UI.
DISABLED_MODELS=

# Optional JSON map of `slotId -> custom display label`, managed via Console UI.
KEY_LABELS={}

# Multi-account load balancing strategy: `quota-aware` (default) | `least-busy` | `round-robin`
LB_STRATEGY=quota-aware

# CPA-style sticky session affinity (keeps multi-turn chats pinned to 1 healthy account)
SESSION_AFFINITY_ENABLED=true
SESSION_AFFINITY_TTL_MS=3600000

# Automatically trip/disable accounts when quota is exhausted or 401 occurs (auto-wakes on billing reset)
AUTO_DISABLE_EXHAUSTED_KEYS=true

# Quota is fetched only when an admin clicks "sync" in the console (never on a timer), to avoid tripping upstream abuse controls.

# ============================================================================
# Engine Timeouts, Session Pools & Payload Limits
# ============================================================================
RUN_IDLE_TIMEOUT_MS=600000
RUN_MAX_TIMEOUT_MS=900000
PARKED_RUN_TTL_MS=300000
MAX_PARKED_RUNS=64
WARM_SESSION_TTL_MS=300000
MAX_WARM_SESSIONS=32
KEY_COOLDOWN_MS=30000
TOOL_BATCH_GRACE_MS=60
MAX_BODY_BYTES=16777216
# Optional runtime state directory (defaults to ENV_FILE_PATH directory; stores gateway-keys.json, admin-session.key, usage-ledger.json).
# DATA_DIR=./data
# Default max in-flight requests per sub-key (0 = unlimited). Each key can override this in the console.
CLIENT_KEY_MAX_CONCURRENT=0

# Written by the gateway: persisted auto-trip state (kind/reason/reset time) per key slot. Do not edit by hand.
# KEY_AUTO_DISABLED={}

# Overview ledger: per-hour counters by model / sub-key / client IP / account. Metadata only, never conversation text.
# Defaults to usage-ledger.json next to this .env.
# USAGE_LEDGER_FILE=
# Record the client IP in the overview ledger (default true). Set false to show no IPs.
# RECORD_CLIENT_IP=true
